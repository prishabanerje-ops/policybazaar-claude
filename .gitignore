data/*-raw/

# Python cache
__pycache__/
.pytest_cache/

# Git worktrees (isolated workspaces for parallel branch work)
.worktrees/

# Nested repo with its own remote (Bitbucket) — not tracked by the root repo
Payoad Experiment/

# Regenerable graphify cache
graphify-out/cache/
