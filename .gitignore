.claude/plugins/
.claude/mcp/
.claude/skills/linkedin/
.claude/skills/post-linkedin/

# Bulky retired data
archive/
old-outputs/

# OS noise
.DS_Store

# Ephemeral MCP browser logs
.playwright-mcp/

# SDD scratch
.superpowers/

# Live run outputs (ai-search scraper etc.) — keep on disk, not in git
aio_*.json
AIO_*.xlsx

# Raw third-party data exports (CRM leads, Screaming Frog crawls, SERP trackers,
